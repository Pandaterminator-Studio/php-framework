<!doctype html>
<html lang="nl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Focaccia bakken{% endblock %} · Kookatelier</title>
    <style>
        :root { color-scheme: light; background: #faf7ef; color: #25322b; font: 100%/1.55 "Source Sans 3", system-ui, sans-serif; }
        * { box-sizing: border-box; }
        body { margin: 0; }
        main { width: min(37rem, calc(100% - 2.5rem)); margin: clamp(2rem, 9vh, 6rem) auto; }
        header { border-top: .3rem solid #326144; padding-top: .8rem; margin-bottom: 2.4rem; font-weight: 650; color: #326144; }
        h1 { font: 500 clamp(2.4rem, 8vw, 4rem)/1.07 Spectral, Georgia, serif; margin: 0 0 1.2rem; }
        p { margin: 0 0 1.4rem; overflow-wrap: anywhere; }
        form, dl { border-top: 1px solid #aeb9a8; padding-top: 1.4rem; }
        label { display: block; margin-bottom: .3rem; font-weight: 650; }
        input, select { width: 100%; padding: .65rem .8rem; border: 1px solid #808c7f; border-radius: .3rem; background: #fff; color: inherit; font: inherit; }
        .field { margin-bottom: 1.15rem; }
        .error { color: #8c3027; margin: .25rem 0 0; }
        button, .action { display: inline-block; background: #284e38; color: #fff; border: 0; border-radius: .3rem; padding: .75rem 1.1rem; font: inherit; font-weight: 650; cursor: pointer; text-decoration: none; }
        :focus-visible { outline: 3px solid #855420; outline-offset: 3px; }
        dl { display: grid; grid-template-columns: max-content 1fr; gap: .55rem 1.5rem; margin: 0 0 1.6rem; }
        dd { margin: 0; font-weight: 650; overflow-wrap: anywhere; }
        footer { margin-top: 2rem; color: #546151; font-size: .9rem; }
    </style>
</head>
<body>
    <main>
        <header>Kookatelier</header>
        {% block content %}{% endblock %}
        <footer>Dit is een voorbeeldformulier. Je naam wordt niet bewaard en er wordt geen plaats geboekt.</footer>
    </main>
</body>
</html>
